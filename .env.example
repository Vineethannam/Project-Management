# Copy to .env; generate your own values. Do not commit secrets.
DATABASE_PASSWORD=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
COOKIE_SECURE=true
# Frontend connection settings are in frontend/.env.example.

# Gmail setup: enable Google 2-Step Verification, then create an App Password:
# https://myaccount.google.com/apppasswords
# Use the 16-character App Password without spaces, NEVER your normal Gmail password.
# Set true after filling the values below. No mail is sent while false.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
# Port 587 uses required STARTTLS. These defaults target Gmail SMTP.
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Use the same Gmail address as MAIL_USERNAME (or a verified sending alias).
MAIL_FROM=
# Browser frontend address used in reset links, NOT the backend URL.
# Local: http://localhost:5173 ; deployed: your HTTPS frontend origin.
FRONTEND_URL=http://localhost:5173
# Restart/recreate the backend after changing these values:
# docker compose up -d --build api
